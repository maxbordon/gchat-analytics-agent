# Copy to .env for local runs. Never commit .env.

# "mock" runs fully offline against data/sample. "gemini" calls the real agent.
AGENT_MODE=mock
# Only honoured in mock mode: lets you POST to / without a Chat token.
SKIP_AUTH=true

AGENT_PROFILE=config/agent.yaml

# --- Required when AGENT_MODE=gemini ---
GOOGLE_CHAT_AUDIENCE=https://your-service-xxxxx.a.run.app
GOOGLE_CHAT_ISSUER_EMAIL=chat@system.gserviceaccount.com
DATA_AGENT_PROJECT=your-gcp-project-id
DATA_AGENT_ID=retail-analytics-agent
DATA_AGENT_LOCATION=global
CHARTS_BUCKET=your-charts-bucket

# Optional: SA registered as the Chat app, if different from the runtime SA.
CHAT_APP_SA_EMAIL=

# Optional: only for Looker data sources.
LOOKER_CLIENT_ID=
LOOKER_CLIENT_SECRET=
